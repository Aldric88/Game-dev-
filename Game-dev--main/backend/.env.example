# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/game_ai_platform?retryWrites=true&w=majority
MONGODB_DB_NAME=game_ai_platform
ALLOW_INMEMORY_FALLBACK=false

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Providers ──────────────────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyApcX3tsN3_G9CSKLnlvs3BWJEryespfwU
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_LOCAL_BASE_URL=
AI_LOCAL_MODEL=local-model
AI_LOCAL_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_REQUESTS_PER_MINUTE=24

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=rediss://default:<password>@your-redis.upstash.io:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-app.vercel.app

# ── HTTPS ─────────────────────────────────────────────────────────────────────
ENFORCE_HTTPS=false

# ── Credits ───────────────────────────────────────────────────────────────────
DEFAULT_CREDITS_FREE=10
DEFAULT_CREDITS_PRO=100

# ── GitHub (optional — raises unauthenticated rate limit from 60 to 5000/hr) ──
GITHUB_TOKEN=
